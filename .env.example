# MCP Gate environment variables
# Copy to .env and fill in values

# Required: API authentication token
# Generate with: openssl rand -hex 32
MCP_TOKEN=CHANGE_ME

# Required for Claude.ai / MCP connector: public URL of this instance
# Used for OAuth 2.0 metadata and SSE endpoint discovery
# Example: https://mcp-gate.example.com
MCP_BASE_URL=

# Data directory inside container (usually no need to change)
DATA_DIR=/data

# Bind address of the published port (default 0.0.0.0), e.g. your LAN IP or 127.0.0.1
# MCPGATE_BIND=127.0.0.1

# ── Events → notify-gate (optional; Telegram/SMTP from the UI are the fallback) ──
# NOTIFY_GATE_URL=http://notify-gate:8010
# NOTIFY_GATE_SOURCE=mcp-gate
# NOTIFY_GATE_TOKEN=           # source token (adapter: json)
# Reverse proxies whose X-Forwarded-For is trusted (client IP in audit/events)
# TRUSTED_PROXIES=172.16.0.0/12
# Who may scrape /metrics (default 127.0.0.1/32)
# METRICS_CIDRS=127.0.0.1/32
# ── Keys (generate each with: openssl rand -base64 48; keep .env in your backups) ──
# MCPGATE_SESSION_KEY=        # signs admin sessions and remembered devices
# MCPGATE_MASTER_KEY=         # Fernet key for secrets and the TOTP seed (default: data/secrets.key)
# MCPGATE_KEY_PEPPER=         # HMAC pepper of agent keys (default: data/key_pepper) — changing it invalidates all agent keys
